modules = ["python-3.12", "nodejs-20"]
run = "uvicorn server.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"
entrypoint = "server/main.py"

[nix]
channel = "stable-24_05"

[env]
WHISPER_MODEL = "base"
HF_HOME = "./.hf_cache"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "pip install -r requirements.txt && python scripts/download_whisper.py && cd frontend && npm ci && npm run build"]
run = ["sh", "-c", "uvicorn server.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]

[[ports]]
localPort = 8000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5173

[workflows]
run = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend"

[[workflows.workflow]]
name = "Backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uvicorn server.main:app --host 0.0.0.0 --port 8000 --reload"

[[workflows.workflow]]
name = "Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev -- --host 0.0.0.0"
